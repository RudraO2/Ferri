# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Answers, planning, drafting. Use claude-haiku-5-5 while testing.
FERRI_MODEL_MAIN=claude-sonnet-5-5
# Per-message triage (question? mood? spam?).
FERRI_MODEL_FAST=claude-haiku-5-5
# Effort for each model: low, medium or high. Tests stay on low.
FERRI_EFFORT_MAIN=low
FERRI_EFFORT_FAST=low

# ── Switch ───────────────────────────────────────────────────────────────────
# Agent bridge base URL (the core API, not the gateway UI).
SWITCH_URL=http://localhost:8000
# Used only by `pnpm setup:switch` to mint a registration key and create rooms.
SWITCH_ADMIN_EMAIL=admin@switch.local
SWITCH_ADMIN_PASSWORD=

# Written by `pnpm setup:switch`. The API key is shown once by Switch.
FERRI_AGENT_ID=
FERRI_AGENT_KEY=
# The room `pnpm setup:switch` creates for the smoke test.
FERRI_LAB_ROOM_ID=
# The crew room `pnpm setup:switch` creates: question cards go here.
FERRI_CREW_ROOM_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# Ferri's own Postgres (pnpm db:up). Supabase later.
DATABASE_URL=postgres://ferri:ferri@localhost:5433/ferri

# ── Behaviour ────────────────────────────────────────────────────────────────
# Seconds Ferri waits on a question nobody addressed to it, so a person can answer first.
FERRI_ROOM_GRACE_SECONDS=20
# Which community this install serves (its slug). Empty: the first one in the database.
FERRI_COMMUNITY=
# Test overrides for the question-card ladder (spec 03). Leave empty in real use:
# nudge at T (10 min while live, 2 h before), escalate at 2T, expire at 24 h or the event's end.
FERRI_NUDGE_SECONDS=
FERRI_CARD_TTL_SECONDS=

# ── Desk ─────────────────────────────────────────────────────────────────────
# Encrypts Desk's session cookie. `pnpm setup:switch` generates it.
DESK_SESSION_SECRET=

# ── Outside platforms (spec 05) ─────────────────────────────────────────────
# Not read by Ferri: Switch stores the credentials with each connection.
# Kept here so a fresh Switch can be connected again (POST /gateway/collaborations).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# ── Ferri Pocket (spec 06) ──────────────────────────────────────────────────
# Web Push keys. `pnpm setup:switch` or `pnpm push:keys` generates them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use (mailto: or https:).
VAPID_SUBJECT=mailto:ferri@localhost
# Extra origins allowed to post Pocket's forms (a tunnel in front of Desk). Comma separated.
POCKET_ALLOWED_ORIGINS=*.trycloudflare.com

# Shield (spec 07): the Switch Trust endpoint inside Ferri. `pnpm shield:connect` writes the key
# and points Switch at http://host.docker.internal:3200.
SHIELD_API_KEY=
SHIELD_PORT=3200
# Optional: Google Safe Browsing v4 reputation lookup (700 ms cap).
GOOGLE_SAFE_BROWSING_KEY=

# ── Ferri Builder (spec 11) ─────────────────────────────────────────────────
# A Claude Code agent Switch runs on this machine (a Switch managed agent on the headless
# agent controller). `pnpm builder:setup` creates it through Ferri; `pnpm builder:controller` runs it.
# Tests run it on Haiku at low effort; switch to Sonnet for the real demo and re-run setup.
FERRI_BUILDER_MODEL=claude-haiku-5-5
FERRI_BUILDER_EFFORT=low
# Its own Switch budget per 24 hours.
FERRI_BUILDER_BUDGET_OUTPUT=400000
FERRI_BUILDER_BUDGET_TURNS=60
# Optional: registry name (default builder), machine name (default ferri-laptop), folders
# (default ~/.ferri/builder for its work, ~/.ferri/builder-claude-home for its own Claude home).
# FERRI_BUILDER_NAME=builder
# FERRI_BUILDER_MACHINE=ferri-laptop
# FERRI_BUILDER_HOME=
# SWITCH_CONTROLLER_CLI=../switch/console/packages/agent-controller/dist/cli.mjs

# The event site the Builder ships (spec 12). Supabase organization and region for its database
# (the Supabase CLI must be signed in), the Vercel scope (the Vercel CLI must be signed in),
# Desk's public address (the site reports registrations and low credit pools to /api/site there)
# and extra organizer emails for the site's admin view (the crew's Switch emails are added).
FERRI_SITE_SUPABASE_ORG=
FERRI_SITE_SUPABASE_REGION=ap-south-1
FERRI_SITE_VERCEL_SCOPE=
FERRI_PUBLIC_URL=https://ferri.example.com
FERRI_SITE_ADMINS=
# Written by `pnpm builder:setup`.
FERRI_SITE_HOOK_SECRET=

# Posters (spec 13): the image model's key (OpenAI). Without it the kit draws its own background.
OPENAI_API_KEY=
FERRI_IMAGE_MODEL=gpt-image-2.6-flare
FERRI_IMAGE_QUALITY=medium

# Listings (spec 14): the Builder's own browser (Chrome with a profile of its own) on this port.
# LUMA_API_KEY only if the Luma calendar has Luma Plus; otherwise Luma goes through the browser.
FERRI_BROWSER_PORT=9333
LUMA_API_KEY=

# Email (spec 15): Resend, with the domain verified for sending and receiving.
# `pnpm email:setup` creates the webhook to FERRI_PUBLIC_URL/api/email and writes its secret.
RESEND_API_KEY=
FERRI_EMAIL_FROM=partners@example.com
FERRI_EMAIL_DAILY_CAP=20
RESEND_WEBHOOK_SECRET=
# The event site's Supabase SMTP: a Resend key that may only send (spec 15).
FERRI_SITE_SMTP_PASS=
FERRI_SITE_EMAIL_FROM=events@example.com

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Answers, planning, drafting. Use claude-haiku-5-5 while testing.
FERRI_MODEL_MAIN=claude-sonnet-5-5
# Per-message triage (question? mood? spam?).
FERRI_MODEL_FAST=claude-haiku-5-5
# Effort for each model: low, medium or high. Tests stay on low.
FERRI_EFFORT_MAIN=low
FERRI_EFFORT_FAST=low

# ── Switch ───────────────────────────────────────────────────────────────────
# Agent bridge base URL (the core API, not the gateway UI).
SWITCH_URL=http://localhost:8000
# Used only by `pnpm setup:switch` to mint a registration key and create rooms.
SWITCH_ADMIN_EMAIL=admin@switch.local
SWITCH_ADMIN_PASSWORD=

# Written by `pnpm setup:switch`. The API key is shown once by Switch.
FERRI_AGENT_ID=
FERRI_AGENT_KEY=
# The room `pnpm setup:switch` creates for the smoke test.
FERRI_LAB_ROOM_ID=
# The crew room `pnpm setup:switch` creates: question cards go here.
FERRI_CREW_ROOM_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# Ferri's own Postgres (pnpm db:up). Supabase later.
DATABASE_URL=postgres://ferri:ferri@localhost:5433/ferri

# ── Behaviour ────────────────────────────────────────────────────────────────
# Seconds Ferri waits on a question nobody addressed to it, so a person can answer first.
FERRI_ROOM_GRACE_SECONDS=20
# Which community this install serves (its slug). Empty: the first one in the database.
FERRI_COMMUNITY=
# Test overrides for the question-card ladder (spec 03). Leave empty in real use:
# nudge at T (10 min while live, 2 h before), escalate at 2T, expire at 24 h or the event's end.
FERRI_NUDGE_SECONDS=
FERRI_CARD_TTL_SECONDS=

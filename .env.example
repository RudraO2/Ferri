# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Answers, planning, drafting.
FERRI_MODEL_MAIN=claude-sonnet-5-5
# Per-message triage (question? mood? spam?).
FERRI_MODEL_FAST=claude-haiku-5-5

# ── Switch ───────────────────────────────────────────────────────────────────
# Agent bridge base URL (the core API, not the gateway UI).
SWITCH_URL=http://localhost:8000
# Used only by `pnpm setup:switch` to mint a registration key and create rooms.
SWITCH_ADMIN_EMAIL=admin@switch.local
SWITCH_ADMIN_PASSWORD=

# Written by `pnpm setup:switch`. The API key is shown once by Switch.
FERRI_AGENT_ID=
FERRI_AGENT_KEY=
# The room `pnpm setup:switch` creates for the smoke test.
FERRI_LAB_ROOM_ID=

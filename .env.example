# Ferri settings. `./ferri up` (Windows: `ferri up`) copies this file to .env, asks for the one
# required key, and generates every secret below. Run `./ferri doctor` to see what is on, off or broken.

# ═══ 1. Required ═════════════════════════════════════════════════════════════
# Your Anthropic API key (console.anthropic.com > API keys). The only value you must give.
ANTHROPIC_API_KEY=

# ═══ 2. Models ═══════════════════════════════════════════════════════════════
# Answers, planning, drafting. claude-haiku-5-5 is cheaper and fine for trying Ferri.
FERRI_MODEL_MAIN=claude-sonnet-5-5
# Per-message triage (question? mood? spam?).
FERRI_MODEL_FAST=claude-haiku-5-5
# Effort for each model: low, medium or high.
FERRI_EFFORT_MAIN=low
FERRI_EFFORT_FAST=low

# ═══ 3. The stack (generated by `./ferri up`; leave as is) ═══════════════════
# Optional parts of the stack. "mattermost" is the local chat for trying Ferri (no account needed).
# Remove it to run without Mattermost (for example on a small server that uses Telegram or Discord).
# Add ",whatsapp" for the WhatsApp sidecar (docs/whatsapp.md).
COMPOSE_PROFILES=mattermost

# Host ports (bound to SWITCH_BIND_ADDR only). Change one if it is taken on your machine.
SWITCH_BIND_ADDR=127.0.0.1
DESK_HOST_PORT=3100
MATTERMOST_HOST_PORT=8065
API_HOST_PORT=8800
GATEWAY_HOST_PORT=3300
FERRI_DB_HOST_PORT=5433
# Mattermost's own address as people open it (change with MATTERMOST_HOST_PORT or a public host).
MATTERMOST_SITE_URL=http://localhost:8065

# Images. Switch's core image is ours: the published Switch core plus the fork's agent message
# edit and WhatsApp bridge (github.com/RudraO2/switch, branch ferri/agent-message-edit).
SWITCH_VERSION=0.31.1-dev.339.g86d5928
SWITCH_IMAGE_NAMESPACE=sandbox-quantum/dev
SWITCH_CORE_IMAGE=ghcr.io/rudrao2/ferri-switch-core
SWITCH_CORE_TAG=0.31.1-dev.339.g86d5928-ferri.1
FERRI_IMAGE=ghcr.io/rudrao2/ferri
FERRI_VERSION=main

# Switch's secrets and accounts.
DB_USER=switch_app
DB_PASSWORD=
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_NAME=switch
SECRET_KEYS=
AGENT_REGISTRATION_TOKEN=
CONTROLLER_TOKEN_SECRET=
FEATURE_FLAGS_ENABLED=agent_management,service_connections,follow_the_conversation
# The Switch admin. Also your Desk and Pocket sign-in.
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
# Mattermost: the admin, the team, and `user` (the Switch admin's Mattermost login).
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=
# Password of the local test people meera, arjun and priya.
MM_TEST_PASSWORD=

# ═══ 4. Ferri (written by setup; leave as is) ═══════════════════════════════
# Where Ferri reaches Switch and its database when you run it on the host (`pnpm dev`).
# Inside the stack the compose file points them at the containers.
SWITCH_URL=http://localhost:8800
DATABASE_URL=postgres://ferri:ferri@localhost:5433/ferri
SWITCH_ADMIN_EMAIL=admin@switch.local
# Empty: the same as GATEWAY_ADMIN_PASSWORD.
SWITCH_ADMIN_PASSWORD=
# Ferri's Switch agent (the key is shown once by Switch) and its two rooms.
FERRI_AGENT_ID=
FERRI_AGENT_KEY=
FERRI_LAB_ROOM_ID=
FERRI_CREW_ROOM_ID=
# Encrypts Desk's session cookie.
DESK_SESSION_SECRET=
# Ferri Pocket's Web Push keys. Changing them drops every phone's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use (mailto: or https:).
VAPID_SUBJECT=mailto:ferri@localhost

# ═══ 5. Behaviour ════════════════════════════════════════════════════════════
# Seconds Ferri waits on a question nobody addressed to it, so a person can answer first.
FERRI_ROOM_GRACE_SECONDS=20
# Which community this install serves (its slug). Empty: the first one in the database.
FERRI_COMMUNITY=
# Test overrides for the question-card ladder. Leave empty in real use: nudge at T (10 min while
# live, 2 h before), escalate at 2T, expire at 24 h or the event's end.
FERRI_NUDGE_SECONDS=
FERRI_CARD_TTL_SECONDS=

# ═══ 6. Optional integrations (all off until set) ═══════════════════════════
# Each one says what it does and the one command that turns it on. `./ferri doctor` shows the state.

# ── Public address: Pocket on phones, RSVP links, email webhooks, the event site's reports ──
# Desk behind HTTPS (a Cloudflare tunnel or your own host), e.g. https://ferri.example.com.
FERRI_PUBLIC_URL=
# Extra origins allowed to post Pocket's forms (comma separated). Baked into the image at build.
POCKET_ALLOWED_ORIGINS=*.trycloudflare.com

# ── Telegram, Slack, Discord: `./ferri connect telegram --token <bot token>` (docs/platforms.md) ──
# Switch stores the credentials with each connection; these are kept so a fresh Switch can reconnect.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# ── WhatsApp through a linked phone: add ",whatsapp" to COMPOSE_PROFILES, then `./ferri whatsapp:pair` ──
# The sidecar's key (generated) and the chats that become rooms: names or ids, "me" for the self chat.
WAHA_API_KEY=
FERRI_WHATSAPP_CHATS=me

# ── Shield, Switch Trust checks on every message: `./ferri shield:connect` (writes the key) ──
SHIELD_API_KEY=
SHIELD_PORT=3200
# Optional: Google Safe Browsing v4 key for link reputation (700 ms cap).
GOOGLE_SAFE_BROWSING_KEY=

# ── Email (partner outreach, guest RSVPs) through Resend: set these, then `./ferri email:setup` ──
# resend.com > API keys; your domain must be verified there for sending (and receiving, for replies).
RESEND_API_KEY=
# Outreach mailbox, e.g. partners@your-domain.org.
FERRI_EMAIL_FROM=
FERRI_EMAIL_DAILY_CAP=20
# Written by `./ferri email:setup`.
RESEND_WEBHOOK_SECRET=
# Guest emails (RSVP), e.g. events@your-domain.org, and the daily cap.
FERRI_GUEST_EMAIL_FROM=
FERRI_GUEST_EMAIL_DAILY_CAP=80
# Tests and rehearsals: email guests only at these domains (comma separated).
FERRI_GUEST_EMAIL_ALLOW=
# How often each live event's guests are synced from Luma and the site (seconds).
FERRI_GUEST_SYNC_SECONDS=600

# ── Ferri Builder, a Claude Code agent Switch runs on your machine: `./ferri builder:setup` (docs/builder.md) ──
FERRI_BUILDER_MODEL=claude-haiku-5-5
FERRI_BUILDER_EFFORT=low
# Its own Switch budget per 24 hours.
FERRI_BUILDER_BUDGET_OUTPUT=400000
FERRI_BUILDER_BUDGET_TURNS=60
# Optional: registry name (default builder), machine name, folders (default ~/.ferri/builder and
# ~/.ferri/builder-claude-home), and the agent controller (default: downloaded by builder:setup).
# FERRI_BUILDER_NAME=builder
# FERRI_BUILDER_MACHINE=
# FERRI_BUILDER_HOME=
# SWITCH_CONTROLLER_CLI=
# The event site the Builder ships: Supabase organization and region (Supabase CLI signed in), the
# Vercel scope (Vercel CLI signed in), extra organizer emails for the site's admin view.
FERRI_SITE_SUPABASE_ORG=
FERRI_SITE_SUPABASE_REGION=ap-south-1
FERRI_SITE_VERCEL_SCOPE=
FERRI_SITE_ADMINS=
# Written by `./ferri builder:setup`.
FERRI_SITE_HOOK_SECRET=
# The event site's sign-in emails through Resend: a send-only Resend key and the sender.
FERRI_SITE_SMTP_PASS=
FERRI_SITE_EMAIL_FROM=

# ── Posters (Builder): the image model's key (OpenAI). Without it the kit draws its own background ──
OPENAI_API_KEY=
FERRI_IMAGE_MODEL=gpt-image-2.6-flare
FERRI_IMAGE_QUALITY=medium

# ── Listings (Builder): its own browser on this port. LUMA_API_KEY only with Luma Plus ──
FERRI_BROWSER_PORT=9333
LUMA_API_KEY=

# ── Social posting through Buffer, with a media host for images (docs/social.md) ──
# publish.buffer.com/settings/api (scopes account:read, posts:read, posts:write).
BUFFER_API_KEY=
# Your deployed media host (infra/media-worker) and its secret.
FERRI_MEDIA_URL=
FERRI_MEDIA_SECRET=

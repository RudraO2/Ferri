{
  "name": "ferri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:switch": "tsx scripts/setup-switch.ts",
    "dev": "pnpm --filter @ferri/agent dev",
    "start": "pnpm --filter @ferri/agent start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:generate": "pnpm --filter @ferri/db generate",
    "db:migrate": "pnpm --filter @ferri/db migrate",
    "kb": "tsx --env-file-if-exists=.env scripts/kb.ts",
    "eval:answers": "tsx --env-file-if-exists=.env scripts/eval-answers.ts",
    "dev:mattermost": "tsx scripts/dev-mattermost.ts",
    "desk": "pnpm --filter @ferri/desk dev",
    "desk:build": "pnpm --filter @ferri/desk build",
    "card:preview": "tsx --env-file-if-exists=.env scripts/card-preview.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "crew:account": "tsx --env-file-if-exists=.env scripts/crew-account.ts",
    "shield:connect": "tsx --env-file-if-exists=.env scripts/shield-connect.ts",
    "builder:setup": "tsx --env-file-if-exists=.env scripts/builder-setup.ts",
    "builder:controller": "tsx scripts/builder-controller.ts",
    "whatsapp:pair": "tsx --env-file-if-exists=.env scripts/whatsapp-pair.ts",
    "email:setup": "tsx --env-file-if-exists=.env scripts/email-setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "@ferri/db": "workspace:*",
    "@ferri/knowledge": "workspace:*",
    "@ferri/push": "workspace:*",
    "@ferri/switch": "workspace:*",
    "@ferri/email": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
